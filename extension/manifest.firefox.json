{
    "manifest_version": 3,
    "name": "OpenBiliClaw",
    "description": "跨平台内容发现 AI Agent — 行为采集、画像与智能推荐",
    "browser_specific_settings": {
        "gecko": {
            "id": "openbiliclaw-firefox@whiteguo233.github.io",
            "data_collection_permissions": {
                "required": [
                    "authenticationInfo",
                    "browsingActivity",
                    "personalCommunications",
                    "searchTerms",
                    "websiteActivity",
                    "websiteContent"
                ]
            },
            "strict_min_version": "140.0"
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    },
    "permissions": [
        "activeTab",
        "alarms",
        "cookies",
        "notifications",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "*://*.bilibili.com/*",
        "*://*.xiaohongshu.com/*",
        "*://*.douyin.com/*",
        "*://*.youtube.com/*",
        "*://*.zhihu.com/*",
        "*://*.reddit.com/*",
        "*://*.redd.it/*",
        "https://linux.do/*",
        "*://*.v2ex.com/*",
        "*://*.weibo.com/*",
        "*://*.weibo.cn/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.bgm.tv/*",
        "*://*.bangumi.tv/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
    ],
    "optional_host_permissions": [
        "https://*.instagram.com/*",
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "scripts": [
            "background/service-worker.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.bilibili.com/*"
            ],
            "js": [
                "content/bilibili.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.bilibili.com/*"
            ],
            "js": [
                "main/bili-interact-tap.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://*.xiaohongshu.com/*"
            ],
            "js": [
                "content/xiaohongshu.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.xiaohongshu.com/*"
            ],
            "js": [
                "main/xhs-token-sniffer.js",
                "main/xhs-state-bridge.js",
                "main/xhs-action-tap.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://*.douyin.com/*"
            ],
            "js": [
                "content/douyin.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "*://*.douyin.com/*"
            ],
            "js": [
                "main/dy-fetch-tap.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content/youtube.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.zhihu.com/*"
            ],
            "js": [
                "content/zhihu.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.weibo.com/*",
                "*://*.weibo.cn/*"
            ],
            "js": [
                "content/weibo.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.reddit.com/*",
                "*://*.redd.it/*"
            ],
            "js": [
                "content/reddit.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://linux.do/*"
            ],
            "js": [
                "content/linuxdo.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.v2ex.com/*"
            ],
            "js": [
                "content/v2ex.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://*.instagram.com/*"
            ],
            "js": [
                "content/instagram.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://*.instagram.com/*"
            ],
            "js": [
                "main/instagram-response-tap.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://*.x.com/*",
                "*://*.twitter.com/*"
            ],
            "js": [
                "content/x.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.x.com/*",
                "*://*.twitter.com/*"
            ],
            "js": [
                "main/x-graphql-tap.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://*.bgm.tv/*",
                "*://*.bangumi.tv/*"
            ],
            "js": [
                "content/bangumi.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.bgm.tv/*",
                "*://*.bangumi.tv/*"
            ],
            "js": [
                "main/bgm-identity-bridge.js"
            ],
            "run_at": "document_idle",
            "world": "MAIN"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "main/dy-fetch-tap.js"
            ],
            "matches": [
                "*://*.douyin.com/*"
            ]
        }
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "sidebar_action": {
        "default_title": "OpenBiliClaw",
        "default_panel": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
