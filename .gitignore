# Build-time copy of src/openbiliclaw/web/shared/ (MV3 CSP forbids loading it
# from the backend over HTTP). Generated by scripts/build.mjs — never edit or
# commit it, or it becomes a second hand-maintained copy of the shared module.
extension/popup/shared/

# Raw screenshots (canonical copies live in docs/images/)
screenshot/

# Local artifacts / debug output
output/
.codex/*
!.codex/skills/
.codex/skills/*
!.codex/skills/add-platform-source/
.codex/skills/add-platform-source/*
